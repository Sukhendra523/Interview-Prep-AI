# Create a Notion internal integration at https://www.notion.so/my-integrations,
# then share your Interview Preparation page with that integration.
NOTION_TOKEN=secret_...
NOTION_ROOT_PAGE_ID=6c3979b889f64ed98748dd79b621ccd0

# Free local AI using Ollama. No API key, billing account, or database is required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b
# Optional: Set secret token if using the Cloudflare / Node auth proxy
OLLAMA_API_KEY=your-secure-secret-token-here

# Free Cloud Vector Database (Qdrant Cloud - 100% Free Forever Cluster at https://cloud.qdrant.io)
QDRANT_URL=https://your-cluster-id.eu-central.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=notion_interview_notes

